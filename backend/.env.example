# Boloka backend environment. Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public project key (sb_publishable_... or a legacy anon JWT). Never use a secret/service-role key here.
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Optional for ES256/RS256: derived from SUPABASE_URL when empty.
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Legacy HS256 projects only: JWT signing secret, NOT an sb_secret_ API key.
SUPABASE_JWT_SECRET=

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173
