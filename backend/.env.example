# Boloka backend environment. Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service role key: SERVER-SIDE ONLY. Never ship this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret (Project Settings -> API -> JWT Settings), used to verify user access tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173
