{
  "name": "boloka-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:open": "cap open android",
    "mobile:apk": "npm run mobile:sync && node scripts/build-android.mjs",
    "localization:review": "node scripts/generate-localization-review.mjs",
    "test": "node --test tests/localization.test.js tests/transactions.test.js",
    "test:e2e": "playwright test",
    "mobile:apk:release": "npm run mobile:sync && node scripts/build-android.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
