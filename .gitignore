# Environment: never commit real secrets. The .env.example templates stay tracked.
.env
.env.*
!.env.example

# Node / frontend
node_modules/
dist/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.codex-build/
work/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Mobile / Capacitor / Android (generated or sensitive)
android/
ios/
*.apk
*.aab
*.keystore
*.jks

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
